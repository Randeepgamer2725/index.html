<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Book Donation Form</title>

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(to right, #667eea, #764ba2);
        margin: 0;
        padding: 20px;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
    }

    .form-container {
        background: white;
        width: 100%;
        max-width: 700px;
        padding: 30px;
        border-radius: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.3);
    }

    h1 {
        text-align: center;
        color: #5a3d9a;
    }

    .subtitle {
        text-align: center;
        color: gray;
        margin-bottom: 25px;
    }

    label {
        font-weight: bold;
        display: block;
        margin-top: 15px;
        color: #333;
    }

    input,
    select,
    textarea {
        width: 100%;
        padding: 12px;
        margin-top: 6px;
        border: 2px solid #ddd;
        border-radius: 10px;
        font-size: 15px;
    }

    input:focus,
    select:focus,
    textarea:focus {
        border-color: #764ba2;
        outline: none;
    }

    button {
        width: 100%;
        padding: 14px;
        margin-top: 20px;
        background: #764ba2;
        color: white;
        border: none;
        border-radius: 10px;
        font-size: 18px;
        cursor: pointer;
    }

    button:hover {
        background: #5a3d9a;
    }

    .thank-you {
        color: green;
        text-align: center;
        font-weight: bold;
        margin-top: 15px;
    }
</style>
</head>

<body>

<div class="form-container">

    <h1>📚 Book Donation Form</h1>
    <p class="subtitle">Donate books and spread knowledge!</p>

    <form id="donationForm">

        <label>👤 Donor Name</label>
        <input type="text" required>

        <label>📧 Email Address</label>
        <input type="email" required>

        <label>📱 Phone Number</label>
        <input type="tel">

        <label>📖 Book Title</label>
        <input type="text" required>

        <label>✍ Author Name</label>
        <input type="text">

        <label>📂 Book Category</label>
        <select>
            <option>Educational</option>
            <option>Fiction</option>
            <option>Science</option>
            <option>Technology</option>
            <option>History</option>
            <option>Comics</option>
        </select>

        <label>⭐ Book Condition</label>
        <select>
            <option>Like New</option>
            <option>Good</option>
            <option>Fair</option>
            <option>Old</option>
        </select>

        <label>📦 Quantity</label>
        <input type="number" min="1" required>

        <label>🏠 Pickup Address</label>
        <textarea rows="3"></textarea>

        <label>📝 Additional Remarks</label>
        <textarea rows="4"></textarea>

        <button type="submit">Donate Now 🚀</button>

        <p id="message" class="thank-you"></p>

    </form>

</div>

<script>

    "✅ Thank you for donating books! Your contribution will help others learn and grow.";

</script>

</body>
</html>